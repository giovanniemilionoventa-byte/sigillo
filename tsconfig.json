{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@sigillo/core": ["packages/core/src/index.ts"],
      "@sigillo/verifier": ["packages/verifier/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "apps/*/src/**/*.ts",
    "apps/*/test/**/*.ts",
    "scripts/**/*.ts",
    "vitest.config.ts"
  ]
}
