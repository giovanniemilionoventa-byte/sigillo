{
  "$description": "Sigillo design tokens, direction \"Registro\" (paper and ink). Source of truth for apps/server/src/http/style.ts. See design/DESIGN.md.",
  "color": {
    "light": {
      "ground":      "#F6F1E7",
      "surface":     "#FFFDF8",
      "ink":         "#1C1917",
      "muted":       "#5C554B",
      "faint":       "#8B8272",
      "rule":        "#D9D0BF",
      "rule-strong": "#948871",
      "accent":      "#8E2A24",
      "ok":          "#1F6B4A",
      "warn":        "#8A5A00",
      "bad":         "#A3261F"
    },
    "dark": {
      "ground":      "#1A1815",
      "surface":     "#221F1B",
      "ink":         "#EFE9DC",
      "muted":       "#B0A899",
      "faint":       "#7F786B",
      "rule":        "#3A362F",
      "rule-strong": "#7A7264",
      "accent":      "#D9756D",
      "ok":          "#7CCB9F",
      "warn":        "#E3B04B",
      "bad":         "#FF8A80"
    }
  },
  "font": {
    "family": {
      "display": "Newsreader, Georgia, serif",
      "ui":      "\"Public Sans\", system-ui, sans-serif",
      "mono":    "\"IBM Plex Mono\", ui-monospace, Menlo, Consolas, monospace"
    },
    "weight": {
      "display": [600],
      "ui":      [400, 500, 600],
      "mono":    [400, 500]
    },
    "size": {
      "page-title": "46px",
      "page-title-min": "44px",
      "page-title-max": "48px",
      "h2":         "28px",
      "row-title":  "24px",
      "lead":       "18px",
      "body":       "16px",
      "body-small": "15px",
      "label":      "12px",
      "mono-cell":  "13px"
    },
    "label": { "transform": "uppercase", "letter-spacing": "0.14em", "family": "mono", "size": "12px" },
    "numeric": "tabular-nums"
  },
  "space": {
    "unit": "4px",
    "page-gutter": "80px",
    "page-gutter-phone": "16px",
    "content-width": "1120px",
    "reference-viewport": "1280px"
  },
  "shape": {
    "radius": "2px",
    "rule": "1px",
    "table-head-rule": "1px solid ink",
    "shadow": "none"
  },
  "control": {
    "button-primary-height": "48px",
    "button-secondary-height": "44px",
    "filter-height": "44px",
    "min-target": "44px",
    "focus-ring": "2px solid accent, 2px offset"
  },
  "header": {
    "height": "72px",
    "active-underline": "2px accent"
  }
}
