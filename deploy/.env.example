# Copy to .env beside docker-compose.yml and fill in.
#
# Nothing secret goes in this file. The web view's password is a file of its
# own, deploy/secrets/admin_password, created once with:
#
#   install -d -m 700 secrets
#   read -rsp 'Password (almeno 12 caratteri): ' P && printf '%s' "$P" > secrets/admin_password && unset P
#   chmod 444 secrets/admin_password
#
# The folder is readable by its owner only; the file inside is readable by the
# container's unprivileged user. Compose hands it to the server as
# /run/secrets/admin_password, so that it shows up neither in
# `docker compose config` nor in `docker inspect`.

# The domain Caddy serves and obtains a certificate for, and the address the
# certificate authority writes to about it. Both are required.
SIGILLO_DOMAIN=sigillo.example.com
SIGILLO_TLS_EMAIL=ops@example.com

# How often each chain is checkpointed, in minutes.
SIGILLO_CHECKPOINT_MINUTES=60

# After how many minutes without activity a system's light turns yellow.
SIGILLO_STALE_AFTER_MINUTES=1440

# Wrong passwords on the web view: after SIGILLO_LOGIN_MAX_FAILURES of them
# within SIGILLO_LOGIN_WINDOW_MINUTES, the address that sent them waits
# SIGILLO_LOGIN_LOCKOUT_MINUTES; each further lockout doubles, up to
# SIGILLO_LOGIN_LOCKOUT_MAX_MINUTES.
SIGILLO_LOGIN_MAX_FAILURES=5
SIGILLO_LOGIN_WINDOW_MINUTES=15
SIGILLO_LOGIN_LOCKOUT_MINUTES=5
SIGILLO_LOGIN_LOCKOUT_MAX_MINUTES=60

# Wrong API keys on the ingest endpoints, per address, per minute.
SIGILLO_INGEST_MAX_FAILURES=20

# The RFC 3161 authority. FreeTSA is fine for a trial and is NOT qualified
# under eIDAS: a deployment that needs qualified timestamps points this at a
# qualified provider. Its password, if it has one, is a secret file too: see
# tsa_password in docker-compose.yml.
TSA_URL=https://freetsa.org/tsr
TSA_USERNAME=
