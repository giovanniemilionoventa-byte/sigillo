# Copy to .env beside docker-compose.yml and fill in.

# The domain Caddy serves and obtains a certificate for.
SIGILLO_DOMAIN=sigillo.example.com
SIGILLO_TLS_EMAIL=ops@example.com

# The one password for the web view. At least 12 characters.
# Leave it unset to run without the web view at all.
SIGILLO_ADMIN_PASSWORD=

# How often each chain is checkpointed.
SIGILLO_CHECKPOINT_MINUTES=60

# The RFC 3161 authority. FreeTSA is fine for a trial and is NOT qualified
# under eIDAS: a deployment that needs qualified timestamps points this at a
# qualified provider.
TSA_URL=https://freetsa.org/tsr
TSA_USERNAME=
TSA_PASSWORD=
