# Caddy obtains and renews the certificate on its own. The domain and the
# contact address come from the environment, so this file is the same on every
# deployment.

{
	email {$SIGILLO_TLS_EMAIL}
}

{$SIGILLO_DOMAIN} {
	encode zstd gzip

	# The ingest endpoints take protobuf and JSON bodies; an OTLP batch from a
	# busy agent can be large.
	request_body {
		max_size 16MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		# Nothing here uses the camera, the microphone or the location, and no
		# other site's window may hold a reference to this one.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		# The web view is server-rendered with one deliberate exception: the
		# "verifica un documento" page hashes a file in the browser with Web
		# Crypto, so the document itself is never sent here. That one inline
		# script is allowed by its own SHA-256, not by relaxing script-src in
		# general. apps/server/test/ui.test.ts recomputes this hash from the
		# actual script and fails the build if it and this line ever disagree.
		Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; script-src 'sha256-/7Wp8lsye3dYo8T7rNpucCUGfdNi7n/BZQltQmigkkE='; form-action 'self'; base-uri 'none'; frame-ancestors 'none'"
		-Server
	}

	# Caddy sends X-Forwarded-For and X-Forwarded-Proto upstream, and replaces
	# whatever a client sent under those names: the server believes them only
	# from this proxy (SIGILLO_TRUST_PROXY).
	reverse_proxy server:8080

	# One line per request, without the query string: in the web view it holds
	# document fingerprints and search terms, which do not belong in a log.
	# Caddy already leaves out the values of Authorization and Cookie. Docker
	# rotates what is written to stderr (see logging in docker-compose.yml).
	log {
		output stderr
		format filter {
			wrap console
			fields {
				request>uri regexp "\?.*$" ""
			}
		}
	}
}
