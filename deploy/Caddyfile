# Caddy obtains and renews the certificate on its own. The domain and the
# contact address come from the environment, so this file is the same on every
# deployment.

{
	email {$SIGILLO_TLS_EMAIL}

	# Every other log line Caddy writes, its own and the errors of a request
	# it could not pass on (a 502 while the server restarts), goes through the
	# same filter as the access log below: such a line quotes the request too,
	# its query string and its headers included.
	log default {
		output stderr
		format filter {
			fields {
				request>uri regexp "\?.*$" ""
				request>headers>X-Api-Key delete
				request>headers>X-Goog-Api-Key delete
			}
		}
	}
}

{$SIGILLO_DOMAIN} {
	# Not on the model gateway: its answers may be streamed (text/event-stream),
	# and compressing a stream holds its events back until a block fills.
	@compressible not path /llm/*
	encode @compressible zstd gzip

	# The ingest endpoints take protobuf and JSON bodies; an OTLP batch from a
	# busy agent can be large.
	request_body {
		max_size 16MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		# Nothing here uses the camera, the microphone or the location, and no
		# other site's window may hold a reference to this one.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		# The web view is server-rendered with one deliberate exception: the
		# "verifica un documento" page hashes a file in the browser with Web
		# Crypto, so the document itself is never sent here. That one inline
		# script is allowed by its own SHA-256, not by relaxing script-src in
		# general. apps/server/test/ui.test.ts recomputes this hash from the
		# actual script and fails the build if it and this line ever disagree.
		# Fonts come from this origin only (apps/server/assets/fonts, served
		# at /fonts/ by apps/server/src/http/fonts.ts). The public site at the
		# root (apps/server/src/http/site.ts) adds, from this origin only, the
		# demo video and its still (/media/) and one script file, /site.js,
		# for its "Copy" buttons. The one script file a console page loads is
		# /ui/agent-setup.js, on the connect page (http/agent-setup.ts).
		Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; font-src 'self'; img-src 'self'; media-src 'self'; script-src 'self' 'sha256-9cCyXgmnD9QCiwTYG/QZN+GEMElkaS71OJol3qmCcqg='; form-action 'self'; base-uri 'none'; frame-ancestors 'none'"
		-Server
	}

	# Caddy sends X-Forwarded-For and X-Forwarded-Proto upstream, and replaces
	# whatever a client sent under those names: the server believes them only
	# from this proxy (SIGILLO_TRUST_PROXY).
	reverse_proxy server:8080

	# One line per request, without the query string: in the web view it holds
	# document fingerprints and search terms, which do not belong in a log, and
	# on the model gateway a Gemini client's sigillo key (?key=). Caddy already
	# leaves out the values of Authorization and Cookie, but not of the other
	# two headers the gateway takes a sigillo key in, X-Api-Key (Anthropic's
	# SDKs) and X-Goog-Api-Key (Google's): those are deleted here. Docker
	# rotates what is written to stderr (see logging in docker-compose.yml).
	log {
		output stderr
		format filter {
			wrap console
			fields {
				request>uri regexp "\?.*$" ""
				request>headers>X-Api-Key delete
				request>headers>X-Goog-Api-Key delete
			}
		}
	}
}
